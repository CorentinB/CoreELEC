+void CVideoDatabase::GetRatingsBatch(const std::vector<int>& media_ids,
+                                     const std::string& media_type,
+                                     std::map<int, RatingMap>& ratingsById)
+{
+  try
+  {
+    if (!m_pDB || !m_pDS2 || media_ids.empty())
+      return;
+
+    // Build comma-separated list of IDs
+    std::string idList;
+    for (size_t i = 0; i < media_ids.size(); ++i)
+    {
+      if (i > 0)
+        idList += ",";
+      idList += std::to_string(media_ids[i]);
+    }
+
+    std::string sql = PrepareSQL(
+        "SELECT media_id, rating_type, rating, votes FROM rating "
+        "WHERE media_id IN (%s) AND media_type = '%s'",
+        idList.c_str(), media_type.c_str());
+
+    m_pDS2->query(sql);
+    while (!m_pDS2->eof())
+    {
+      int mediaId = m_pDS2->fv(0).get_asInt();
+      std::string ratingType = m_pDS2->fv(1).get_asString();
+      float rating = m_pDS2->fv(2).get_asFloat();
+      int votes = m_pDS2->fv(3).get_asInt();
+
+      ratingsById[mediaId][ratingType] = CRating(rating, votes);
+      m_pDS2->next();
+    }
+    m_pDS2->close();
+  }
+  catch (...)
+  {
+    CLog::Log(LOGERROR, "{} failed", __FUNCTION__);
+  }
+}
